# CUDA Test RAG Environment Variables
# Copy this file to .env and fill in your values

# Google AI API Key (required) - Get free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# LLM Model (optional, default: gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash

# Embedding Model (optional, default: models/embedding-001)
# EMBEDDING_MODEL=models/embedding-001

# Use local embeddings instead of Google API (optional, default: false)
# USE_LOCAL_EMBEDDINGS=true

# Local embedding model (optional, default: all-MiniLM-L6-v2)
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Temperature for generation (optional, default: 0.1)
# TEMPERATURE=0.1

# Chunk size for document splitting (optional, default: 1000)
# CHUNK_SIZE=1000

# Chunk overlap (optional, default: 200)
# CHUNK_OVERLAP=200

# Number of documents to retrieve (optional, default: 4)
# RETRIEVAL_K=4

# Reranker settings (optional)
# Reranker type: bge, none (default: none)
# RERANKER_TYPE=bge
# Reranker model (default: BAAI/bge-reranker-v2-m3)
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Number of docs after reranking (optional, default: same as RETRIEVAL_K)
# RERANKER_TOP_K=4

# Vector store path (optional, default: ./data/vectorstore)
# VECTORSTORE_PATH=./data/vectorstore

# Collection name (optional, default: cuda_test_docs)
# COLLECTION_NAME=cuda_test_docs

# Documents directory (optional, default: ./data/docs)
# DOCS_PATH=./data/docs
